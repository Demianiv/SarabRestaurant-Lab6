@model SarabRestaurant.Models.EmailViewModel

@{
    ViewData["Title"] = Localizer["SendEmail"].Value;
}

<section class="py-5" style="min-height: 70vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">

                <div class="text-center mb-5">
                    <h2>@Localizer["SendEmail"]</h2>
                    <p>@Localizer["EmailDescription"]</p>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Success"]
                    </div>
                }

                <form asp-controller="Email"
                      asp-action="Index"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email"
                               class="form-label">
                            @Localizer["EmailAddress"]
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="example@gmail.com" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Message"
                               class="form-label">
                            @Localizer["Message"]
                        </label>

                        <textarea asp-for="Message"
                                  class="form-control"
                                  rows="6"
                                  placeholder="@Localizer["MessagePlaceholder"]"></textarea>

                        <span asp-validation-for="Message"
                              class="text-danger"></span>
                    </div>

                    <div class="text-center">
                        <button type="submit"
                                class="btn btn-danger px-5 py-3">
                            @Localizer["Submit"]
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</section>